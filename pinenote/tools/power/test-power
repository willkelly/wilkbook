                                      (main (list "snapshot" "--root" root "--phase" "stdout"
                                                  "--timestamp" "1" "--output" "-"))))))
(ok (and (= stdout-status 0) (string-contains stdout-report "(snapshot"))
    "snapshot stdout output works")
(ok (not (safe-output-path? (string-append root "/ordinary-report.scm")))
    "collector rejects ordinary report files")
(ok (not (safe-output-path? "/sys/power/state")) "direct virtual output path rejected")
(ok (not (safe-output-path? "../outside.scm")) "lexical traversal output path rejected")
(symlink "/sys" (string-append root "/symlink-to-sys"))
(ok (not (safe-output-path? (string-append root "/symlink-to-sys/report.scm")))
    "symlinked parent into virtual filesystem rejected")
(symlink "/run/wilkbook-power-never-create" (string-append root "/dangling-output"))
(ok (not (safe-output-path? (string-append root "/dangling-output")))
    "dangling output symlink rejected")
(delete-file (string-append root "/dangling-output"))
(ok (= (main (list "snapshot" "--root" root "--phase" "blocked" "--timestamp" "1"
                    "--output" (string-append root "/symlink-to-sys/report.scm"))) 2)
    "unsafe snapshot output fails before opening")
(define snapshot-out (string-append root "/snapshot-out.scm"))
(call-with-output-file snapshot-out (lambda (port) (write a port) (newline port)))
(ok (= (main (list "snapshot" "--root" root "--phase" "cli" "--timestamp" "1" "--output" snapshot-out)) 2)
    "snapshot file output rejected")
(define delta-status #f)
(define delta-report (with-output-to-string
                       (lambda () (set! delta-status
                                     (main (list "delta" snapshot-out snapshot-out "--output" "-"))))))
(ok (and (= delta-status 0) (string-contains delta-report "(delta")) "delta stdout output works")
(call-with-output-file (string-append root "/bad.scm") (lambda (p) (display "(snapshot (schema \"wrong\") (version 1))" p)))
(ok (= (main (list "delta" snapshot-out (string-append root "/bad.scm"))) 2) "wrong schema rejected")
(define collector-source (call-with-input-file "power-snapshot.scm" get-string-all))
(ok (not (or (string-contains collector-source "call-with-output-file")
              (string-contains collector-source "open-output-file")
              (string-contains collector-source "system*")
              (string-contains collector-source "reboot")
              (string-contains collector-source "poweroff")))
    "collector has no file-write API or mutating command")
(remove-tree root)
(if (= failures 0) (begin (display "RESULT: ok\n") (exit 0)) (begin (display "RESULT: failed\n") (exit 1)))
