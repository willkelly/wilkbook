(define failures 0)
(define (ok value label) (display (format #f "~a: ~a~%" (if value "PASS" "FAIL") label))
  (if (not value) (set! failures (+ failures 1))))
(define root (string-append "/tmp/wilkbook-power-fixture-" (number->string (getpid))))
(define (remove-tree path)
  (when (file-exists? path)
    (if (eq? (stat:type (lstat path)) 'symlink)
        (delete-file path)
        (if (file-is-directory? path)
        (begin (for-each (lambda (name) (unless (member name '("." ".."))
                                             (remove-tree (string-append path "/" name)))) (scandir path))
               (rmdir path))
        (delete-file path)))))
(remove-tree root)
(define (ensure-dir path)
  (unless (file-exists? path)
    (ensure-dir (dirname path))
    (mkdir path #o755)))
(define (put path value)
  (let ((full (string-append root path)))
    (ensure-dir (dirname full))
    (call-with-output-file full (lambda (p) (display value p)))))
