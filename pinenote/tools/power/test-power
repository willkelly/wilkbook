(define (contains? tree needle)
  (or (equal? tree needle) (and (pair? tree) (or (contains? (car tree) needle)
                                                   (contains? (cdr tree) needle)))))
(define (entry-with-change entries change)
  (find (lambda (entry) (equal? (lookup 'change entry) change)) entries))
(define (entry-with-key entries key)
  (find (lambda (entry) (equal? (lookup 'key entry) key)) entries))
(ok (and (equal? (lookup 'schema a) schema-name) (= (lookup 'version a) schema-version)) "snapshot schema and version")
(ok (equal? (lookup 'state (lookup 'system-power a))
            '(available (source "/sys/power/state") (value "freeze mem"))) "system power record fields")
(define dt-wakes (lookup 'dt-wakeup-sources (lookup 'system-power a)))
(define dt-idle (lookup 'dt-cpu-idle-states (lookup 'system-power a)))
(ok (equal? (lookup 'paths dt-wakes)
            '("/sys/firmware/devicetree/base/gpio-keys/switch-cover/wakeup-source"
              "/sys/firmware/devicetree/base/i2c@fdd40000/pmic@20/wakeup-source"))
    "DT wake-source paths are sorted and bounded")
(ok (equal? (lookup 'nodes dt-idle) '("state0" "state1")) "DT idle-state child nodes collected")
(define minimal-root (string-append root "/minimal"))
(ensure-dir minimal-root)
(define minimal-snapshot (snapshot minimal-root "minimal" 1))
(define minimal-system-power (lookup 'system-power minimal-snapshot))
(ok (and (eq? (car (lookup 'dt-wakeup-sources minimal-system-power)) 'absent)
          (eq? (car (lookup 'dt-cpu-idle-states minimal-system-power)) 'absent))
     "absent DT evidence is explicit")
(ok (eq? (car (lookup 'power-supplies minimal-snapshot)) 'unavailable)
    "failed directory enumeration is explicit")
(ok (and (lookup 'stat (lookup 'cpu a)) (lookup 'frequency (lookup 'cpu a))
         (lookup 'idle (lookup 'cpu a))) "CPU compound record fields")
(ok (and (lookup 'network (lookup 'workload a)) (lookup 'usb-gadget (lookup 'workload a))
          (lookup 'orientation (lookup 'workload a))) "workload compound record fields")
(define network-record (lookup 'network (lookup 'workload a)))
(define usb-record (lookup 'usb-gadget (lookup 'workload a)))
(ok (and (lookup 'interfaces network-record) (lookup 'wireless network-record))
    "network interfaces and wireless are sibling fields")
(ok (and (lookup 'udcs usb-record) (lookup 'gadgets usb-record))
    "USB UDCs and gadgets are sibling fields")
(ok (equal? (lookup 'name (lookup 'ebc-runtime-pm (lookup 'workload a))) "fdec0000.ebc")
    "EBC context is one named platform device")
(ok (equal? (lookup 'elapsed-seconds d) '(delta 10)) "numeric timestamp delta")
(define battery-domain (lookup 'battery d))
(define interrupt-domain (lookup 'interrupts d))
(define wakeup-domain (lookup 'wakeup-sources d))
(define runtime-domain (lookup 'runtime-pm d))
(define process-domain (lookup 'processes d))
(define cpu-domain (lookup 'cpu d))
(define policy0 (car (lookup 'frequency (lookup 'cpu a))))
(define policy0-properties (lookup 'properties policy0))
(define policy-names (map (lambda (record) (lookup 'name record))
                          (lookup 'frequency (lookup 'cpu a))))
(ok (equal? (lookup 'semantics battery-domain) 'signed-observation) "battery delta semantics")
(ok (equal? (lookup 'semantics interrupt-domain) 'monotonic-counter) "interrupt delta semantics")
(ok (entry-with-change (lookup 'entries interrupt-domain) '(delta 3)) "keyed interrupt CPU counters delta")
(ok (entry-with-change (lookup 'entries wakeup-domain) '(delta 1)) "wakeup-source counters delta")
(ok (entry-with-change (lookup 'entries runtime-domain) '(delta 10)) "runtime PM time delta")
(ok (entry-with-change (lookup 'entries process-domain) '(delta 19)) "selected process CPU delta")
(ok (entry-with-change (lookup 'entries battery-domain) '(delta -5)) "battery signed observation delta")
(ok (equal? (lookup 'value (cadr (assoc "stats/time_in_state" policy0-properties)))
            "408000 12\n1800000 8") "multiline cpufreq time-in-state preserved")
(ok (equal? policy-names '("policy0")) "cpufreq excludes boost and governor directories")
(ok (equal? (lookup 'change (entry-with-key (lookup 'entries cpu-domain)
                                           '(record frequency (record "policy0") properties "stats/total_trans" available value)))
            '(delta 25)) "cpufreq total-trans stable monotonic delta")
(define reordered-before
  '(snapshot (schema "wilkbook-pinenote-power") (version 1) (phase "before") (timestamp 1)
             (interrupts (available (source "/proc/interrupts")
                         (entries ((interrupt (irq "29") (cpu-counts (10 20)))
                                    (interrupt (irq "30") (cpu-counts (1 2)))))))
              (processes (selected ((process (pid "42") (cpu (available (source "/proc/42/stat") (utime 1) (stime 1) (starttime 100))))
                                    (process (pid "43") (cpu (available (source "/proc/43/stat") (utime 2) (stime 2) (starttime 200)))))))))
(define reordered-after
  '(snapshot (schema "wilkbook-pinenote-power") (version 1) (phase "after") (timestamp 2)
             (interrupts (available (source "/proc/interrupts")
                         (entries ((interrupt (irq "99") (cpu-counts (7 8)))
                                   (interrupt (irq "30") (cpu-counts (4 6)))
                                    (interrupt (irq "29") (cpu-counts (13 25)))))))
              (processes (selected ((process (pid "99") (cpu (available (source "/proc/99/stat") (utime 3) (stime 3) (starttime 300))))
                                    (process (pid "43") (cpu (available (source "/proc/43/stat") (utime 6) (stime 7) (starttime 200))))
                                    (process (pid "42") (cpu (available (source "/proc/42/stat") (utime 5) (stime 4) (starttime 100)))))))))
(define reordered-delta (delta reordered-before reordered-after))
(define reordered-interrupt-entries (lookup 'entries (lookup 'interrupts reordered-delta)))
(define reordered-process-entries (lookup 'entries (lookup 'processes reordered-delta)))
(ok (equal? (lookup 'change (entry-with-key reordered-interrupt-entries
                                           '(available entries (interrupt "29") cpu-counts 0)))
            '(delta 3)) "reordered IRQ key has no outer index")
(ok (equal? (lookup 'change (entry-with-key reordered-process-entries
                                            '(selected (process "42" 100) cpu available utime)))
             '(delta 4)) "reordered process key has no outer index")
(ok (equal? (numeric-delta 9 3) '(reset (before 9) (after 3))) "counter reset explicit")
