(ok (= (main '("snapshot" "--phase" "x" "--unknown" "x")) 2) "unknown CLI option rejected")
(ok (safe-output-path? "-") "stdout report output allowed")
(define stdout-status #f)
(define stdout-report (with-output-to-string
