From: wilkbook packaging
Subject: build: parameterize Coral crosstool for Guix store toolchains

This patch is applied to a prepared override_repository copy after the two
upstream gVisor Coral patches. It removes /bin/bash probes, /usr paths, and
supplies only the native and AArch64 toolchain roots declared by Guix.
Other Coral targets remain visibly unsupported.

--- a/configure.bzl
+++ b/configure.bzl
@@ -13,6 +13,15 @@
 # limitations under the License.
 """Rules for configuring the C++ cross-toolchain."""
 
+def _required_env(repository_ctx, name):
+    value = repository_ctx.os.environ.get(name)
+    if not value:
+        fail("the Guix gVisor package did not declare %s" % name)
+    return value
+
+def _quoted_paths(value):
+    return ", ".join(['"%s"' % path for path in value.split(":") if path])
+
 def _impl(repository_ctx):
     dir_labels = repository_ctx.attr.additional_system_include_directories
