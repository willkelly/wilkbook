-    bcm2708_toolchain_root = repository_ctx.os.environ.get("BCM2708_TOOLCHAIN_ROOT", "/tools/arm-bcm2708")
+    native_prefix = _required_env(repository_ctx, "GVISOR_GUIX_NATIVE_TOOL_PREFIX")
+    aarch64_prefix = _required_env(repository_ctx, "GVISOR_GUIX_AARCH64_TOOL_PREFIX")
+    native_includes = _required_env(repository_ctx, "GVISOR_GUIX_NATIVE_INCLUDE_ROOTS")
+    aarch64_includes = _required_env(repository_ctx, "GVISOR_GUIX_AARCH64_INCLUDE_ROOTS")
     repository_ctx.template(
         "cc_toolchain_config.bzl",
         Label("//:cc_toolchain_config.bzl.tpl"),
         {
-            "%{gcc_version}%": gcc_version,
+            "%{aarch64_include_directories}%": _quoted_paths(aarch64_includes),
+            "%{aarch64_tool_prefix}%": aarch64_prefix,
+            "%{native_include_directories}%": _quoted_paths(native_includes),
+            "%{native_tool_prefix}%": native_prefix,
             "%{c_version}%": repository_ctx.attr.c_version,
