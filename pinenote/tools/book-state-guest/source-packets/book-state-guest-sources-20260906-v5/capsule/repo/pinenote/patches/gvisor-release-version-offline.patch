From: wilkbook packaging
Subject: build: stamp the pinned release without Git or an FHS shell

git-fetch deliberately supplies no .git directory.  Stamp the fixed release
and commit directly. Bazel's workspace-status action unconditionally invokes
/bin/sh before it can execute this script, so the package disables that command
and supplies the same release through Bazel's built-in BUILD_EMBED_LABEL. Point
the existing x_defs and version-file rule at that stable built-in key.

--- a/tools/workspace_status.sh
+++ b/tools/workspace_status.sh
@@ -15,4 +15,5 @@
 # limitations under the License.
 
 # The STABLE_ prefix will trigger a re-link if it changes.
-echo STABLE_VERSION "$(git describe --always --tags --abbrev=12 --dirty 2>/dev/null || echo 0.0.0)"
+echo STABLE_VERSION release-20260831.0
+echo STABLE_GVISOR_COMMIT fd2f6b2674208086e324c2f739155eb7e1b48ff2
--- a/runsc/BUILD
+++ b/runsc/BUILD
@@ -14,7 +14,7 @@ go_binary(
     visibility = [
         "//visibility:public",
     ],
-    x_defs = {"gvisor.dev/gvisor/runsc/version.version": "{STABLE_VERSION}"},
+    x_defs = {"gvisor.dev/gvisor/runsc/version.version": "{BUILD_EMBED_LABEL}"},
     deps = [
         "//runsc/cli/maincli",
         "//runsc/version",
@@ -32,7 +32,7 @@ go_binary(
