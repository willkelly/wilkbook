+(define (process-hooks-for integration role argv environment cwd stdout-path
+                           stderr-path timeout grace)
+  (unless (memq role book-state-process-roles)
+    (runner-error (format #f "unknown fixed Book State process role: ~s" role)))
+  (let ((hooks
