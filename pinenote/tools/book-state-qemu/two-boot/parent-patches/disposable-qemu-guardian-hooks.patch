+(define (wait-for-owner-observation owner-liveness deadline)
+  ;; The exec child remains blocked behind release-read until the owner has
+  ;; recorded its stable PID/start-time identity.  EOF means the owner failed or
+  ;; died, in which case the guardian tears down the still-unexecuted child.
+  (let loop ()
+    (let ((remaining (- deadline (monotonic-seconds))))
+      (cond
+       ((<= remaining 0) 'setup-timeout)
+       (else
+        (match (select (list owner-liveness) '() '()
+                       0 (inexact->exact
+                          (round (* 1000000 (min remaining 0.02)))))
+          ((() () ()) (loop))
+          ((_ () ())
+           (let ((value (read-char owner-liveness)))
+             (cond
+              ((eof-object? value) 'owner-dead)
+              ((char=? value #\R) 'ready)
+              (else 'setup-failed))))))))))
 
