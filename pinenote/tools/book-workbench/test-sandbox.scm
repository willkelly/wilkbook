    (display "Evidence: public runtime refuses missing prerequisites (no native fallback)\n")
    (let ((value ((make-sandbox-preview `((language-closure . ()) (timeout-seconds . 0))) seed "x")))
      (test-equal "config callback returns ordinary failed contract" 'failed (field value 'status))
      (test-equal "invalid timeout has no execution proof" #f (field value 'execution-started?))
      (test-equal "invalid timeout conservatively lacks cleanup proof" #f (field value 'cleanup-complete?)))
    (let ((value (preview-sandbox seed "x" #:timeout-seconds 31)))
      (test-equal "trusted timeout cannot exceed global bound" 'failed (field value 'status)))
    (unless (= (getuid) 0)
      (test-assert "real runtime preflight refuses non-root without touching cgroups"
        (rejected? (lambda () ((sandbox 'runtime-preflight!) "nonroot-offline-test")))))
    (let ((mutex (@@ (workbench-preview) native-mutex)))
      (lock-mutex mutex)
      (dynamic-wind
        (lambda () #t)
        (lambda ()
          (let ((value (join-thread (call-with-new-thread (lambda () (preview-sandbox seed "x"))))))
            (test-equal "overlapping native/sandbox execution rejected" 'failed (field value 'status))
            (test-assert "overlap diagnostic" (string-contains (field value 'diagnostic) "active"))))
        (lambda () (unlock-mutex mutex))))
    (display "Actual runsc execution: NOT RUN by this offline test; use the QEMU integration gate.\n"))
  (lambda () (remove-tree root)))
(let ((runner (test-runner-current)))
  (test-end "workbench-sandbox")
  (exit (if (zero? (test-runner-fail-count runner)) 0 1)))
