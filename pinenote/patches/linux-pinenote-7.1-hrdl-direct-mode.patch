+			uint8x16_t q8_gray_dithered = vminq_u8(
+				vqsubq_u8(vqaddq_u8(q8_gray,
+						    q8_dither_pattern0),
+					  q8_0x08),
+				q8_0x0f);
+			uint8x16_t q8_gray_y2_dt =
