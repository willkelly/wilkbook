@@ -648,6 +688,23 @@
 	dma_sync_single_for_device(dev, next_handle, gray4_size, DMA_TO_DEVICE);
 	dma_sync_single_for_device(dev, prev_handle, gray4_size, DMA_TO_DEVICE);
 
+	/*
+	 * ebc-dbg (1): a credit already present in display_end at global
+	 * launch means a DSP_END from the preceding activity was produced
+	 * but never consumed by a wait -- the straggler the quirk F
+	 * zero-gap analysis predicts.  reinit_completion() below absorbs
+	 * it silently (the ioctl path's structural immunity); a straggler
+	 * that instead arrives AFTER the reinit satisfies the wait early,
+	 * which the elapsed-time log at (2) catches.
+	 */
+	if (completion_done(&ebc->display_end))
+		pr_warn("ebc-dbg: straggler credit present at global launch (threshold=%d src=%s burst_timeouts=%u total_timeouts=%u)\n",
+			ebc->dbg_gsrc == EBC_DBG_GSRC_THRESHOLD,
+			ebc_dbg_gsrc_names[ebc->dbg_gsrc],
+			ebc->dbg_burst_frame_timeouts,
+			ebc->dbg_frame_timeouts);
+	dbg_t0 = ktime_get();
+
 	reinit_completion(&ebc->display_end);
 	regmap_write(ebc->regmap, EBC_CONFIG_DONE,
 		     EBC_CONFIG_DONE_REG_CONFIG_DONE);
@@ -661,10 +718,28 @@
 		kfree(area);
 	}
 
-	if (!wait_for_completion_timeout(&ebc->display_end,
-					 EBC_REFRESH_TIMEOUT))
+	dbg_wait_ret = wait_for_completion_timeout(&ebc->display_end,
+						   EBC_REFRESH_TIMEOUT);
+	if (!dbg_wait_ret)
 		drm_err(drm, "Refresh timed out!\n");
 
+	/*
+	 * ebc-dbg (2): elapsed wall time vs the expected LUT playback
+	 * duration.  The panel frame clock runs at ~85 Hz (~11.8 ms per
+	 * frame), so a full global should take about num_phases * 11.8 ms.
+	 * A wait that returns much earlier than expect~ is a truncated
+	 * wash, even when no prior credit was seen at (1) -- the straggler
+	 * arrived inside the reinit->wait window instead of before it.
+	 */
+	dbg_elapsed_ms = ktime_ms_delta(ktime_get(), dbg_t0);
+	dbg_expect_ms = ebc->lut.num_phases * 1000 / 85;
+	pr_info("ebc-dbg: global wait returned %lu after %lld ms (src=%s phases=%u expect~%u ms burst_timeouts=%u total_timeouts=%u)\n",
+		dbg_wait_ret, dbg_elapsed_ms,
+		ebc_dbg_gsrc_names[ebc->dbg_gsrc],
+		ebc->lut.num_phases, dbg_expect_ms,
+		ebc->dbg_burst_frame_timeouts,
+		ebc->dbg_frame_timeouts);
+
 	memcpy(ctx->prev, ctx->next, gray4_size);
 	// this was the first global refresh after resume, reset the variable
 	ebc->suspend_was_requested = 0;
@@ -1105,6 +1180,9 @@
 	/* 	drm_err(drm, "phase_handles[0] dma mapping error"); */
 	/* } */
 
+	/* ebc-dbg (3): per-burst frame-timeout counter. */
