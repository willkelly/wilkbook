 		}
 
 		if (!wait_for_completion_timeout(&ebc->display_end,
-						 EBC_FRAME_TIMEOUT))
+						 EBC_FRAME_TIMEOUT)) {
+			/* ebc-dbg (3): count handshake desyncs so the two
+			 * global-launch logs can distinguish timeout-desync
