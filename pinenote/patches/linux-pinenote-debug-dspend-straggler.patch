--- a/drivers/gpu/drm/rockchip/rockchip_ebc.c	2026-07-11 21:14:09.424107690 -0600
+++ b/drivers/gpu/drm/rockchip/rockchip_ebc.c	2026-07-11 21:16:40.535277253 -0600
@@ -153,6 +153,29 @@
 #define EBC_OFFCONTENT "rockchip/rockchip_ebc_default_screen.bin"
 MODULE_FIRMWARE(EBC_OFFCONTENT);
 
+/*
+ * ebc-dbg: quirk F straggler-credit instrumentation (wilkbook debug patch
+ * linux-pinenote-debug-dspend-straggler.patch; printk-only, no behavior
+ * change; see doc/driver-findings-report.md, finding 2026-07-12).
+ * Records the provenance of the most recent global-refresh launch so the
+ * log lines can distinguish threshold-fired globals (the suspect zero-gap
+ * path) from ioctl-fired ones (the clean control).
+ */
+enum ebc_dbg_gsrc {
+	EBC_DBG_GSRC_UNKNOWN = 0,
+	EBC_DBG_GSRC_INIT,	/* probe-time initial full refresh */
+	EBC_DBG_GSRC_RESET,	/* RESET waveform at thread start */
+	EBC_DBG_GSRC_RESUME,	/* post-resume restore refresh */
+	EBC_DBG_GSRC_IOCTL,	/* GLOBAL_REFRESH ioctl */
+	EBC_DBG_GSRC_THRESHOLD,	/* auto_refresh damage-threshold epilogue */
+	EBC_DBG_GSRC_OFFSCREEN,	/* suspend/shutdown off-screen wash */
+};
+
+static const char *const ebc_dbg_gsrc_names[] = {
+	"unknown", "init", "reset", "resume", "ioctl", "threshold",
+	"offscreen",
+};
+
 struct rockchip_ebc {
 	struct clk			*dclk;
 	struct clk			*hclk;
@@ -192,6 +215,16 @@
 	u8				*final_buffer[2];
 	u8              *final_atomic_update;
 	u8				*phase[2];
+
+	/* ebc-dbg state (debug patch only).  dbg_pending_gsrc is written
+	 * under refresh_once_lock alongside do_one_full_refresh (except at
+	 * probe/resume, matching the unlocked flag writes there); dbg_gsrc
+	 * and the frame-timeout counters are touched only by the refresh
+	 * thread. */
+	int				dbg_pending_gsrc;
+	int				dbg_gsrc;
+	unsigned int			dbg_frame_timeouts;
+	unsigned int			dbg_burst_frame_timeouts;
 };
 
 static int default_waveform = DRM_EPD_WF_GC16;
@@ -316,6 +349,7 @@
 		/* printk(KERN_INFO "[rockchip_ebc] ioctl_trigger_global_refresh"); */
 		spin_lock(&ebc->refresh_once_lock);
 		ebc->do_one_full_refresh = true;
+		ebc->dbg_pending_gsrc = EBC_DBG_GSRC_IOCTL;	/* ebc-dbg */
 		spin_unlock(&ebc->refresh_once_lock);
