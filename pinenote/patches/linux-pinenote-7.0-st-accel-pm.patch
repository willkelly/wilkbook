-EXPORT_SYMBOL_NS(st_sensors_init_sensor, "IIO_ST_SENSORS");
+EXPORT_SYMBOL_NS(st_sensors_reinit_hw, "IIO_ST_SENSORS");
+
+/*
+ * System sleep support.
+ *
+ * The ST sensor drivers previously had no power management at all.  Across
+ * a suspend that actually removes power (platform "deep" on RK356x, for
+ * example) the chip returns at its reset defaults: the configured ODR,
+ * full-scale, BDU/DAS and axis enables are gone, and crucially the
+ * data-ready interrupt is left in a state the driver never programmed.
+ * With a level-triggered DRDY line the threaded handler then cannot clear
+ * the source, the IRQ re-asserts forever, and the kernel's spurious
+ * interrupt protection disables it permanently:
+ *
+ *   irq NN: nobody cared (try booting with the "irqpoll" option)
+ *
+ * after which the sensor is dead until reboot.  Observed on a Pine64
+ * PineNote (SC7A20 on i2c, level-triggered via rockchip GPIO) on both a
+ * 6.12 and a 7.0 kernel.
+ */
+static int st_sensors_suspend(struct device *dev)
+{
+	struct iio_dev *indio_dev = dev_get_drvdata(dev);
+	struct st_sensor_data *sdata = iio_priv(indio_dev);
+
+	/* Remember what to come back to; set_enable() clears ->enabled. */
+	sdata->pm_enabled = sdata->enabled;
+
+	/*
+	 * Mask the data-ready line for the duration.  This is the load-bearing
+	 * half of the fix, and reprogramming registers on resume is not enough
+	 * without it: resume_device_irqs() runs at the noirq stage, BEFORE
+	 * driver .resume callbacks, so on a suspend that removed power the
+	 * interrupt is re-enabled while the chip sits at reset defaults with
+	 * its level-triggered line asserted.  The threaded handler then runs
+	 * before anything has reconfigured the device, cannot clear the
+	 * source, and the kernel's spurious protection disables the interrupt
+	 * permanently:
+	 *
+	 *   irq NN: nobody cared (try booting with the "irqpoll" option)
+	 *
+	 * Observed on a PineNote 0.7 s after each resume from platform "deep"
+	 * until this bracket was added.
+	 */
+	if (sdata->irq > 0 && !sdata->pm_irq_disabled) {
+		disable_irq(sdata->irq);
+		sdata->pm_irq_disabled = true;
+	}
+
+	if (!sdata->pm_enabled)
+		return 0;
+
+	return st_sensors_set_enable(indio_dev, false);
+}
+
+static int st_sensors_resume(struct device *dev)
+{
+	struct iio_dev *indio_dev = dev_get_drvdata(dev);
+	struct st_sensor_data *sdata = iio_priv(indio_dev);
+	int err;
+
+	/* The chip may have lost power: reprogram from cached state. */
+	err = st_sensors_reinit_hw(indio_dev);
+	if (err < 0)
+		return err;
+
+	/*
+	 * Re-arm the data-ready interrupt only when a trigger owns it.
+	 * st_sensors_reinit_hw() has just masked it, which is what makes
+	 * the line quiet again after a power loss.
+	 */
+	if (sdata->hw_irq_trigger) {
+		err = st_sensors_set_dataready_irq(indio_dev, true);
+		if (err < 0)
+			return err;
+	}
+
+	if (sdata->pm_enabled) {
+		err = st_sensors_set_enable(indio_dev, true);
+		if (err < 0)
+			return err;
+	}
+
+	/* Only now is it safe to let the handler run again. */
+	if (sdata->pm_irq_disabled) {
+		sdata->pm_irq_disabled = false;
+		enable_irq(sdata->irq);
+	}
+
+	return 0;
+}
+
+/*
+ * Note: EXPORT_NS_*_PM_OPS() stringifies its namespace argument (#ns),
+ * unlike EXPORT_SYMBOL_NS() which takes an already-quoted string.  Passing
+ * "IIO_ST_SENSORS" here would export into the namespace "\"IIO_ST_SENSORS\""
+ * and modpost would reject every importer.
+ */
+EXPORT_NS_SIMPLE_DEV_PM_OPS(st_sensors_pm_ops, st_sensors_suspend,
+			    st_sensors_resume, IIO_ST_SENSORS);
 
 int st_sensors_set_dataready_irq(struct iio_dev *indio_dev, bool enable)
 {
