+/*
+ * Parallel dispatcher for the NORMAL-mode advance.  Motivation
+ * (doc/status.md 2026-08-26 part 11): a single band takes ~18 ms for
+ * the full panel at 1.8 GHz against the panel's 12.0 ms scan period,
+ * so every large refresh runs its waveform ~1.5x out of the vendor
+ * timing contract.  Bands are row-disjoint; each worker enters its own
+ * kernel-NEON section, and the dispatcher computes the last band on
+ * the calling thread instead of idling.  Callers must NOT wrap this in
+ * scoped_ksimd() -- the dispatcher sleeps in wait_for_completion(),
+ * which is illegal inside a kernel NEON section; each band execution
+ * takes its own.
+ */
+struct rockchip_ebc_advance_work {
+	struct work_struct work;
+	struct completion done;
+	const struct rockchip_ebc *ebc;
+	const u8 *prelim_target;
+	u8 *hints;
+	u8 *phase_buffer;
+	const struct drm_rect *clip_bounds;
+	int y_begin, y_end;
+	struct drm_rect out_ongoing;
+	struct drm_rect out_ongoing_or_waiting;
+	u8 eca, force_wf, force_hint, force_hint_mask;
+	bool allow_schedule;
+};
+
+static void rockchip_ebc_advance_band_run(struct rockchip_ebc_advance_work *w)
+{
+	scoped_ksimd()
+		rockchip_ebc_schedule_advance_band(w->ebc, w->prelim_target,
+						   w->hints, w->phase_buffer,
+						   w->clip_bounds,
+						   w->y_begin, w->y_end,
+						   &w->out_ongoing,
+						   &w->out_ongoing_or_waiting,
+						   w->eca, w->force_wf,
+						   w->force_hint,
+						   w->force_hint_mask,
+						   w->allow_schedule);
+}
+
+static void rockchip_ebc_advance_work_fn(struct work_struct *work)
+{
+	struct rockchip_ebc_advance_work *w =
+		container_of(work, struct rockchip_ebc_advance_work, work);
+
+	rockchip_ebc_advance_band_run(w);
+	complete(&w->done);
+}
+
+/*
+ * Union of possibly-"empty" band results.  An all-idle band reports the
+ * same encoding the single-threaded advance always has (mins stay
+ * 0xffff, maxs stay 0, so x2 = 16 and width <= 0); callers test
+ * emptiness by width, so the merged result must preserve one such
+ * encoding when every band is empty.
+ */
+static void rockchip_ebc_rect_union_nonempty(struct drm_rect *acc,
+					     const struct drm_rect *b)
+{
+	if (b->x2 <= b->x1 || b->y2 <= b->y1)
+		return;
+	if (acc->x2 <= acc->x1 || acc->y2 <= acc->y1) {
+		*acc = *b;
+		return;
+	}
+	acc->x1 = min(acc->x1, b->x1);
+	acc->y1 = min(acc->y1, b->y1);
+	acc->x2 = max(acc->x2, b->x2);
+	acc->y2 = max(acc->y2, b->y2);
+}
+
+/* 0 = auto (one band per CPU up to the max); N = force exactly N
+ * bands.  A/B instrument: force 1 to compare the banded advance
+ * against the original single-threaded path on identical state. */
+static int advance_bands = 0;
+module_param(advance_bands, int, 0644);
+MODULE_PARM_DESC(advance_bands, "advance worker bands (0 = auto)");
+
+#define ROCKCHIP_EBC_ADVANCE_MAX_BANDS 4
+/* Below this many rows per band the workqueue round trip is not worth
+ * dodging: a band this size computes in ~2 ms. */
+#define ROCKCHIP_EBC_ADVANCE_PAR_MIN_ROWS 176
+
+void rockchip_ebc_schedule_advance_parallel_neon(
+	const struct rockchip_ebc *ebc, const u8 *prelim_target, u8 *hints,
+	u8 *phase_buffer, struct drm_rect *clip_ongoing,
+	struct drm_rect *clip_ongoing_or_waiting,
+	u8 early_cancellation_addition, u8 force_wf, u8 force_hint,
+	u8 force_hint_mask, bool allow_schedule)
+{
+	struct rockchip_ebc_advance_work works[ROCKCHIP_EBC_ADVANCE_MAX_BANDS];
+	struct drm_rect bounds = *clip_ongoing_or_waiting;
+	int y0 = max(0, bounds.y1);
+	int y1 = min((int)ebc->height, bounds.y2);
+	int rows = y1 - y0;
+	int nbands, rows_per, i;
+
+	if (advance_bands > 0)
+		nbands = min(advance_bands, ROCKCHIP_EBC_ADVANCE_MAX_BANDS);
+	else
+		nbands = min3((int)num_online_cpus(),
+			      ROCKCHIP_EBC_ADVANCE_MAX_BANDS,
+			      rows / ROCKCHIP_EBC_ADVANCE_PAR_MIN_ROWS);
+	if (nbands < 2) {
+		scoped_ksimd()
+			rockchip_ebc_schedule_advance_band(
+				ebc, prelim_target, hints, phase_buffer,
+				&bounds, y0, y1, clip_ongoing,
+				clip_ongoing_or_waiting,
+				early_cancellation_addition, force_wf,
+				force_hint, force_hint_mask, allow_schedule);
+		return;
+	}
+
+	rows_per = DIV_ROUND_UP(rows, nbands);
+	for (i = 0; i < nbands; ++i) {
+		struct rockchip_ebc_advance_work *w = &works[i];
+
+		w->ebc = ebc;
+		w->prelim_target = prelim_target;
+		w->hints = hints;
+		w->phase_buffer = phase_buffer;
+		w->clip_bounds = &bounds;
+		w->y_begin = y0 + i * rows_per;
+		w->y_end = min(y1, y0 + (i + 1) * rows_per);
+		w->eca = early_cancellation_addition;
+		w->force_wf = force_wf;
+		w->force_hint = force_hint;
+		w->force_hint_mask = force_hint_mask;
+		w->allow_schedule = allow_schedule;
+		if (i < nbands - 1) {
+			init_completion(&w->done);
+			INIT_WORK_ONSTACK(&w->work,
+					  rockchip_ebc_advance_work_fn);
+			queue_work(system_unbound_wq, &w->work);
+		}
+	}
+
+	/* The calling thread takes the last band instead of idling. */
+	rockchip_ebc_advance_band_run(&works[nbands - 1]);
+
+	for (i = 0; i < nbands - 1; ++i) {
+		wait_for_completion(&works[i].done);
+		destroy_work_on_stack(&works[i].work);
+	}
+
+	*clip_ongoing = works[nbands - 1].out_ongoing;
+	*clip_ongoing_or_waiting = works[nbands - 1].out_ongoing_or_waiting;
+	for (i = 0; i < nbands - 1; ++i) {
+		rockchip_ebc_rect_union_nonempty(clip_ongoing,
+						 &works[i].out_ongoing);
+		rockchip_ebc_rect_union_nonempty(
+			clip_ongoing_or_waiting,
+			&works[i].out_ongoing_or_waiting);
+	}
+}
+EXPORT_SYMBOL(rockchip_ebc_schedule_advance_parallel_neon);
