diff --git a/drivers/soc/rockchip/rockchip_suspend_activate.c b/drivers/soc/rockchip/rockchip_suspend_activate.c
new file mode 100644
index 0000000000000000000000000000000000000000..6f8e72b185bb8e7fd24711b8b840d26c7979db06
--- /dev/null
+++ b/drivers/soc/rockchip/rockchip_suspend_activate.c
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/suspend.h>
+
+#include "rockchip_suspend_backend.h"
+#include "rockchip_suspend_model.h"
+#include "rockchip_suspend_of.h"
+
+struct rockchip_suspend_activation {
+	struct device *dev;
+	struct rockchip_suspend_backend_context backend;
+	struct rockchip_suspend_model_policy policy;
+	struct rockchip_suspend_model_event probe_events[
+		ROCKCHIP_SUSPEND_MODEL_MAX_PROBE_EVENTS];
+	struct rockchip_suspend_model_event prepare_events[
+		ROCKCHIP_SUSPEND_MODEL_MAX_PREPARE_EVENTS];
+};
+
+static int rockchip_suspend_execute(struct rockchip_suspend_activation *activation,
+	struct rockchip_suspend_model_event *events, int count)
+{
+	u32 failed_index;
+
+	if (count < 0)
+		return count;
+	if (!count)
+		return 0;
+
+	return rockchip_suspend_executor_run(&rockchip_suspend_real_ops,
+		&activation->backend,
+		 events, count, &failed_index);
+}
+
+static int rockchip_suspend_fail(struct device *dev,
+	struct rockchip_suspend_activation *activation, int error, bool rollback)
+{
+	int rollback_error = 0;
+
+	rockchip_suspend_model_transaction_poison(
+		&activation->backend.transaction);
+	if (rollback)
+		rollback_error = rockchip_suspend_backend_rollback(&activation->backend);
+	if (rollback_error)
+		dev_err(dev, "failed to restore regulator suspend policy: %d\n",
+			rollback_error);
+
+	return error ? error : rollback_error;
+}
+
+static int rockchip_suspend_prepare(struct device *dev)
+{
+	struct rockchip_suspend_activation *activation = dev_get_drvdata(dev);
+	int prepare_count;
+	int probe_count;
+	int ret;
+
+	if (!activation)
+		return -ENODEV;
+	ret = rockchip_suspend_model_transaction_begin(
+		&activation->backend.transaction);
+	if (ret)
+		return rockchip_suspend_fail(dev, activation, ret, true);
+	if (pm_suspend_target_state != PM_SUSPEND_MEM)
+		return rockchip_suspend_fail(dev, activation, -EOPNOTSUPP, false);
+	probe_count = rockchip_suspend_model_build_probe(&activation->policy,
+		activation->probe_events, ARRAY_SIZE(activation->probe_events));
+	if (probe_count < 0)
+		return rockchip_suspend_fail(dev, activation, probe_count, false);
+	prepare_count = rockchip_suspend_model_build_prepare(&activation->policy,
+		PM_SUSPEND_MEM, activation->prepare_events,
+		ARRAY_SIZE(activation->prepare_events));
+	if (prepare_count < 0)
+		return rockchip_suspend_fail(dev, activation, prepare_count, false);
+	ret = rockchip_suspend_execute(activation, activation->probe_events,
+		probe_count);
+	if (ret) {
+		return rockchip_suspend_fail(dev, activation, ret, true);
+	}
+	ret = rockchip_suspend_execute(activation, activation->prepare_events,
+		prepare_count);
+	if (ret)
+		return rockchip_suspend_fail(dev, activation, ret, true);
+
+	return 0;
+}
+
+static void rockchip_suspend_complete(struct device *dev)
+{
+	struct rockchip_suspend_activation *activation = dev_get_drvdata(dev);
+
+	if (activation) {
+		int ret = rockchip_suspend_backend_rollback(&activation->backend);
+
+		if (ret) {
+			rockchip_suspend_model_transaction_poison(
+				&activation->backend.transaction);
+			dev_err(dev, "failed to restore regulator suspend policy: %d\n",
+				ret);
+		}
+	}
+}
+
+static const struct dev_pm_ops rockchip_suspend_pm_ops = {
+	.prepare = rockchip_suspend_prepare,
+	.complete = rockchip_suspend_complete,
+};
+
+static void rockchip_suspend_rollback(void *data)
+{
+	struct rockchip_suspend_activation *activation = data;
+	int ret;
+
+	ret = rockchip_suspend_backend_rollback(&activation->backend);
+	if (ret) {
+		rockchip_suspend_model_transaction_poison(
+			&activation->backend.transaction);
+		dev_crit(activation->dev,
+			"failed to restore regulator suspend policy during teardown: %d\n",
+			ret);
+	}
+}
+
+static void rockchip_suspend_release_policy(void *data)
+{
+	struct rockchip_suspend_activation *activation = data;
+
+	rockchip_suspend_of_put(&activation->policy);
+}
+
+static int rockchip_suspend_activate_probe(struct platform_device *pdev)
+{
+	struct rockchip_suspend_activation *activation;
+	int ret;
+
+	activation = devm_kzalloc(&pdev->dev, sizeof(*activation), GFP_KERNEL);
+	if (!activation)
+		return -ENOMEM;
+	activation->dev = &pdev->dev;
+	ret = rockchip_suspend_of_parse(&pdev->dev, pdev->dev.of_node,
+		&activation->policy);
+	if (ret)
+		return ret;
+	if (!activation->policy.value.sleep_mode.present ||
+	    !activation->policy.value.wakeup.present) {
+		rockchip_suspend_of_put(&activation->policy);
+		return dev_err_probe(&pdev->dev, -ENODATA,
+			"activation requires sleep-mode and wakeup policy\n");
+	}
+	ret = devm_add_action_or_reset(&pdev->dev, rockchip_suspend_release_policy,
+		activation);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(&pdev->dev, rockchip_suspend_rollback,
+		activation);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, activation);
+	dev_info(&pdev->dev, "BSP suspend policy activated\n");
+
+	return 0;
+}
+
+static const struct of_device_id rockchip_suspend_activate_of_match[] = {
+	{ .compatible = "rockchip,pm-rk3568" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, rockchip_suspend_activate_of_match);
+
+static struct platform_driver rockchip_suspend_activate_driver = {
+	.probe = rockchip_suspend_activate_probe,
+	.driver = {
+		.name = "rockchip-suspend-mode",
+		.of_match_table = rockchip_suspend_activate_of_match,
+		.pm = &rockchip_suspend_pm_ops,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(rockchip_suspend_activate_driver);
+
+MODULE_DESCRIPTION("Rockchip activated BSP SIP suspend policy");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/rockchip/rockchip_suspend_backend.c b/drivers/soc/rockchip/rockchip_suspend_backend.c
new file mode 100644
index 0000000000000000000000000000000000000000..e7c51112330662e0f4b89c584c7b1534014f074d
--- /dev/null
+++ b/drivers/soc/rockchip/rockchip_suspend_backend.c
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/arm-smccc.h>
+#include <linux/cpu.h>
+#include <linux/errno.h>
+#include <linux/regulator/consumer.h>
+#include <linux/suspend.h>
+#include <asm/suspend.h>
+
+#include <soc/rockchip/rockchip_legacy_sip.h>
+
+#include "rockchip_suspend_backend.h"
+
+static int rockchip_suspend_sip(void *context, u32 control, u32 arg1, u32 arg2)
+{
+	struct arm_smccc_res result;
+
+	arm_smccc_smc(ROCKCHIP_LEGACY_SIP_SUSPEND_MODE, control, arg1, arg2,
+		0, 0, 0, 0, &result);
+
+	return rockchip_suspend_sip_status(result.a0);
+}
+
+static suspend_state_t rockchip_suspend_regulator_state(u32 state)
+{
+	if (state == ROCKCHIP_SUSPEND_MODEL_MEM)
+		return PM_SUSPEND_MEM;
+
+	return PM_SUSPEND_ON;
+}
+
+static int rockchip_suspend_regulator(void *context, unsigned long regulator,
+	enum rockchip_suspend_model_regulator_action action, u32 state)
+{
+	struct rockchip_suspend_backend_context *backend = context;
+	struct regulator *consumer;
+	suspend_state_t suspend_state;
+	int previous;
+	int ret;
+
+	if (!backend ||
+	    backend->transaction.restore_count >= ROCKCHIP_SUSPEND_MODEL_MAX_RESTORES)
+		return -ENOSPC;
+	suspend_state = rockchip_suspend_regulator_state(state);
+	if (suspend_state == PM_SUSPEND_ON)
+		return -EINVAL;
+	consumer = (struct regulator *)regulator;
+	if (!consumer)
+		return -EINVAL;
+	if (action != ROCKCHIP_SUSPEND_MODEL_REGULATOR_ENABLE &&
+	    action != ROCKCHIP_SUSPEND_MODEL_REGULATOR_DISABLE)
+		ret = -EINVAL;
+	else
+		ret = regulator_set_suspend_enable_save(consumer, suspend_state,
+			action == ROCKCHIP_SUSPEND_MODEL_REGULATOR_ENABLE,
+			&previous);
+	if (!ret)
+		ret = rockchip_suspend_model_transaction_add(&backend->transaction,
+			regulator, suspend_state, previous);
+	return ret;
+}
+
+static int rockchip_suspend_restore_regulator(void *context,
+	const struct rockchip_suspend_model_restore *restore)
+{
+	return regulator_restore_suspend_enable(
+		(struct regulator *)restore->target, restore->state,
+		restore->previous);
+}
+
+int rockchip_suspend_backend_rollback(
+	struct rockchip_suspend_backend_context *context)
+{
+	if (!context)
+		return -EINVAL;
+
+	return rockchip_suspend_model_transaction_rollback(&context->transaction,
+		rockchip_suspend_restore_regulator, NULL);
+}
+
+static int rockchip_suspend_regulator_prepare(void *context, u32 state)
+{
+	(void)context;
+	(void)state;
+
+	return -EOPNOTSUPP;
+}
+
+static int rockchip_suspend_regulator_finish(void *context)
+{
+	return rockchip_suspend_backend_rollback(context);
+}
+
+static int rockchip_suspend_disable_cpus(void *context)
+{
+	return suspend_disable_secondary_cpus();
+}
+
+static void rockchip_suspend_enable_cpus(void *context)
+{
+	suspend_enable_secondary_cpus();
+}
+
+static int rockchip_suspend_psci_finish(unsigned long unused)
+{
+	struct arm_smccc_res result;
+
+	arm_smccc_smc(ROCKCHIP_SUSPEND_MODEL_PSCI_FN64_SYSTEM_SUSPEND,
+		__pa_symbol(cpu_resume), 0, 0, 0, 0, 0, 0, &result);
+
+	return rockchip_suspend_psci_status(result.a0);
+}
+
+static int rockchip_suspend_psci(void *context)
+{
+	return cpu_suspend(0, rockchip_suspend_psci_finish);
+}
+
+const struct rockchip_suspend_executor_ops rockchip_suspend_real_ops = {
+	.sip = rockchip_suspend_sip,
+	.regulator = rockchip_suspend_regulator,
+	.regulator_prepare = rockchip_suspend_regulator_prepare,
+	.regulator_finish = rockchip_suspend_regulator_finish,
+	.disable_secondary_cpus = rockchip_suspend_disable_cpus,
+	.enable_secondary_cpus = rockchip_suspend_enable_cpus,
+	.psci_system_suspend = rockchip_suspend_psci,
+};
