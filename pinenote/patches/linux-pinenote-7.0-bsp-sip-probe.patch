--- a/drivers/regulator/of_regulator.c
+++ b/drivers/regulator/of_regulator.c
@@ -642,6 +642,35 @@ static struct regulator_dev *of_find_regulator_by_node(struct device_node *np)
 	return dev ? dev_to_rdev(dev) : NULL;
 }
 
+/**
+ * of_regulator_get_by_node - get a regulator consumer by exact OF node
+ * @dev: regulator consumer device
+ * @node: regulator provider device node
+ *
+ * Return: regulator consumer handle, -EINVAL for invalid input, or
+ * -EPROBE_DEFER if the provider is not registered yet.
+ */
+struct regulator *of_regulator_get_by_node(struct device *dev,
+					   struct device_node *node)
+{
+	struct regulator *regulator;
+	struct regulator_dev *rdev;
+
+	if (!dev || !node)
+		return ERR_PTR(-EINVAL);
+
+	rdev = of_find_regulator_by_node(node);
+	if (!rdev)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	get_device(&rdev->dev);
+	regulator = _regulator_get_common(rdev, dev, "of-node", NORMAL_GET);
+	put_device(&rdev->dev);
+
+	return regulator;
+}
+EXPORT_SYMBOL_GPL(of_regulator_get_by_node);
