diff --git a/drivers/regulator/core.c b/drivers/regulator/core.c
index 2286bdf6edcbf4d351cad2df6504943669ccb6ef..59143abc9300ae908bc837d87f8c21c97d9c0253 100644
--- a/drivers/regulator/core.c
+++ b/drivers/regulator/core.c
@@ -4557,6 +4557,84 @@ int regulator_suspend_disable(struct regulator_dev *rdev,
 }
 EXPORT_SYMBOL_GPL(regulator_suspend_disable);
 
+int regulator_set_suspend_enable(struct regulator *regulator,
+				 suspend_state_t state)
+{
+	int ret;
+
+	if (IS_ERR_OR_NULL(regulator))
+		return -EINVAL;
+	regulator_lock(regulator->rdev);
+	ret = regulator_suspend_enable(regulator->rdev, state);
+	regulator_unlock(regulator->rdev);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(regulator_set_suspend_enable);
+
+int regulator_set_suspend_disable(struct regulator *regulator,
+				  suspend_state_t state)
+{
+	int ret;
+
+	if (IS_ERR_OR_NULL(regulator))
+		return -EINVAL;
+	regulator_lock(regulator->rdev);
+	ret = regulator_suspend_disable(regulator->rdev, state);
+	regulator_unlock(regulator->rdev);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(regulator_set_suspend_disable);
+
+int regulator_set_suspend_enable_save(struct regulator *regulator,
+				      suspend_state_t state, bool enable,
+				      int *previous)
+{
+	struct regulator_state *rstate;
+	int ret;
+
+	if (IS_ERR_OR_NULL(regulator) || !previous)
+		return -EINVAL;
+	regulator_lock(regulator->rdev);
+	rstate = regulator_get_suspend_state(regulator->rdev, state);
+	if (!rstate) {
+		ret = -EINVAL;
+		goto out;
+	}
+	*previous = rstate->enabled;
+	if (enable)
+		ret = regulator_suspend_enable(regulator->rdev, state);
+	else
+		ret = regulator_suspend_disable(regulator->rdev, state);
+out:
+	regulator_unlock(regulator->rdev);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(regulator_set_suspend_enable_save);
+
+int regulator_restore_suspend_enable(struct regulator *regulator,
+				     suspend_state_t state, int previous)
+{
+	struct regulator_state *rstate;
+	int ret = 0;
+
+	if (IS_ERR_OR_NULL(regulator) ||
+	    previous < DO_NOTHING_IN_SUSPEND || previous > ENABLE_IN_SUSPEND)
+		return -EINVAL;
+	regulator_lock(regulator->rdev);
+	rstate = regulator_get_suspend_state(regulator->rdev, state);
+	if (!rstate)
+		ret = -EINVAL;
+	else
+		rstate->enabled = previous;
+	regulator_unlock(regulator->rdev);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(regulator_restore_suspend_enable);
+
 static int _regulator_set_suspend_voltage(struct regulator *regulator,
 					  int min_uV, int max_uV,
 					  suspend_state_t state)
diff --git a/drivers/regulator/of_regulator.c b/drivers/regulator/of_regulator.c
