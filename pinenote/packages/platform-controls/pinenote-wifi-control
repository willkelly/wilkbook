#!/bin/sh
set -eu

action=${1:-}
run_dir=${PINENOTE_WIFI_RUN_DIR:-/run/wilkbook-power}
proc_root=${PINENOTE_WIFI_PROC_ROOT:-/proc}
sys_root=${PINENOTE_WIFI_SYS_ROOT:-/sys}
conf=${PINENOTE_WIFI_CONF:-/data/wifi/wlan0.conf}
pidfile="$run_dir/wpa_supplicant-wlan0.pid"
state="$run_dir/wifi.state"
iface=wlan0
mkdir -p "$run_dir"

wpa_supplicant_bin=${PINENOTE_WIFI_WPA_SUPPLICANT:-/run/current-system/profile/sbin/wpa_supplicant}
rfkill_bin=${PINENOTE_WIFI_RFKILL:-/run/current-system/profile/sbin/rfkill}
dhcpcd_bin=${PINENOTE_WIFI_DHCPCD:-/run/current-system/profile/sbin/dhcpcd}
if [ ! -x "$wpa_supplicant_bin" ]; then wpa_supplicant_bin=$(command -v wpa_supplicant 2>/dev/null || true); fi
if [ ! -x "$rfkill_bin" ]; then rfkill_bin=$(command -v rfkill 2>/dev/null || true); fi
if [ ! -x "$dhcpcd_bin" ]; then dhcpcd_bin=$(command -v dhcpcd 2>/dev/null || true); fi
kill_cmd=${PINENOTE_WIFI_KILL:-kill}
logfile="$run_dir/wifi.log"
watchpid="$run_dir/wifi.watch"
# Every message goes to stderr (the caller's log) AND to $run_dir/wifi.log
# with a timestamp: the broker's log does not capture this script's output,
# and the cycle rig judges from this file.
say() { echo "pinenote-wifi: $*" >&2; printf '%s pinenote-wifi: %s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$*" >> "$logfile" 2>/dev/null || true; }

# Waits, in tenths of a second (overridable so the host harness runs in
# milliseconds): the interface after a resume's firmware reload, the interface
# after a driver rebind, and the association after the supplicant starts.
iface_wait=${PINENOTE_WIFI_IFACE_WAIT:-50}
rebind_wait=${PINENOTE_WIFI_REBIND_WAIT:-150}
assoc_wait=${PINENOTE_WIFI_ASSOC_WAIT:-150}

matching_pid() {
    pid=$1
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    [ -r "$proc_root/$pid/cmdline" ] || return 1
    cmd=$(tr '\000' ' ' < "$proc_root/$pid/cmdline")
    case "$cmd" in
        *wpa_supplicant*"-i $iface"*"-c $conf"*|*wpa_supplicant*"-i$iface"*"-c$conf"*) return 0;;
        *) return 1;;
    esac
}

valid_pid() {
    [ -r "$pidfile" ] || return 1
    matching_pid "$(sed -n '1p' "$pidfile")"
}

# The stock image starts one supplicant without -P.  During validation we
# adopt it only when there is exactly one process whose interface and config
# both match our ownership contract.  Ambiguity is a hard refusal: launching
# another daemon or guessing which process to signal would both be unsafe.
adopt_pid() {
    [ ! -e "$pidfile" ] || return 1
    found=
    for process in "$proc_root"/[0-9]*; do
        candidate=${process##*/}
        matching_pid "$candidate" || continue
        [ -z "$found" ] || {
            say "multiple matching supplicants; refusing ownership"
            return 1
        }
        found=$candidate
    done
    [ -n "$found" ] || return 1
    printf '%s\n' "$found" > "$pidfile"
    pid=$found
    say "adopted existing supplicant pid=$pid"
}

wifi_on() {
    valid_pid || adopt_pid || return 1
    [ -e "$sys_root/class/net/$iface" ]
}

wait_iface() {
    i=0
    while [ ! -e "$sys_root/class/net/$iface" ] && [ "$i" -lt "$1" ]; do
        sleep 0.1; i=$((i + 1))
    done
    [ -e "$sys_root/class/net/$iface" ]
}

# The ultra suspend powers the SDIO card off (cap-power-off-card), so every
# resume is a full brcmfmac re-probe: firmware download, then attach.  When
# the attach's first control exchange times out ("brcmf_sdio_bus_rxctl:
# resumed on timeout", 2026-09-03) the driver releases both SDIO functions
# and nothing rebinds them -- wlan0 never returns until a cold boot.  The
# device nodes stay in sysfs, so a rebind of function 2 (the one whose probe
# does the work) reruns exactly the path a clean resume takes.
rebind_driver() {
    drv="$sys_root/bus/sdio/drivers/brcmfmac"
    [ -d "$drv" ] || { say "no brcmfmac driver to rebind"; return 1; }
    func=
    for candidate in "$sys_root"/bus/sdio/devices/*:2; do
        [ -e "$candidate" ] || continue
        func=${candidate##*/}
    done
    [ -n "$func" ] || { say "no SDIO function 2 to rebind"; return 1; }
    if [ -e "$sys_root/bus/sdio/devices/$func/driver" ]; then
        printf '%s\n' "$func" > "$drv/unbind" 2>/dev/null || true
    fi
    printf '%s\n' "$func" > "$drv/bind" 2>/dev/null || {
        say "bind of $func failed"; return 1
    }
    say "rebound brcmfmac on $func"
}

start_supplicant() {
    "$wpa_supplicant_bin" -B -P "$pidfile" -i "$iface" -c "$conf"
    valid_pid
}

stop_supplicant() {
    valid_pid || return 0
    "$kill_cmd" "$pid" 2>/dev/null || true
    i=0
    while [ -e "$proc_root/$pid" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
    [ ! -e "$proc_root/$pid" ] || { say "supplicant did not exit"; return 1; }
    rm -f "$pidfile"
}

associated() {
    [ "$(cat "$sys_root/class/net/$iface/carrier" 2>/dev/null || echo 0)" = 1 ]
}

wait_assoc() {
    i=0
    while ! associated && [ "$i" -lt "$1" ]; do sleep 0.1; i=$((i + 1)); done
    associated
}

case "$action" in
status)
    if wifi_on; then echo "on pid=$pid"; exit 0; fi
    echo off; exit 1
    ;;
on)
    if wifi_on; then say "already on pid=$pid"; exit 0; fi
    [ -f "$conf" ] || { say "missing $conf"; exit 1; }
    if valid_pid; then
        # A live supplicant with no wlan0 -- the driver gave up under it.
        # Stop it before the rebind hands it an interface to fight the new
        # one for (wpa_supplicant re-attaches to its ifname on RTM_NEWLINK).
        say "stopping the supplicant that lost its interface (pid=$pid)"
        stop_supplicant || exit 1
    elif [ -e "$pidfile" ]; then
        say "removing stale or foreign pid file"
        rm -f "$pidfile"
    fi
    [ -z "$rfkill_bin" ] || "$rfkill_bin" unblock wifi || true
    if ! wait_iface "$iface_wait"; then
        say "wlan0 absent after $((iface_wait / 10)) s; rebinding the driver"
        rebind_driver || { say "wlan0 unavailable"; exit 1; }
        wait_iface "$rebind_wait" || { say "wlan0 unavailable after rebind"; exit 1; }
    fi
    [ -n "$wpa_supplicant_bin" ] || { say "wpa_supplicant unavailable"; exit 1; }
    start_supplicant || { say "supplicant pid validation failed"; exit 1; }
    if [ -n "$dhcpcd_bin" ]; then
        "$dhcpcd_bin" -n "$iface" >/dev/null 2>&1 || "$dhcpcd_bin" -b "$iface" >/dev/null 2>&1 || true
    fi
    printf 'on\n' > "$state"
    say "on pid=$pid"
    # The association retry runs detached: `on` is called synchronously on
    # KOReader's UI thread and by the broker's resume path, neither of which
    # may block for the wait.  `off` kills the watcher.
    if [ "$assoc_wait" -gt 0 ]; then
        setsid "$0" assoc-watch </dev/null >/dev/null 2>&1 &
        printf '%s\n' "$!" > "$watchpid"
    fi
    ;;
assoc-watch)
    # only our own record: a later `on` may already have written a newer watcher's pid
    trap 'if [ "$(sed -n 1p "$watchpid" 2>/dev/null)" = "$$" ]; then rm -f "$watchpid"; fi' EXIT
    # One association retry: a supplicant that comes up against a radio still
    # settling after the reload can sit unassociated; a fresh start fixes it.
    # No AP in range looks the same and is not a fault, so the result is
    # reported, not fatal.
    if wait_assoc "$assoc_wait"; then say "associated within $((assoc_wait / 10)) s"; exit 0; fi
    valid_pid || { say "association watch: no validated supplicant to restart"; exit 0; }
    say "no association within $((assoc_wait / 10)) s; restarting the supplicant once"
    if stop_supplicant && start_supplicant; then
        if wait_assoc "$assoc_wait"; then say "associated after the restart"
        else say "still no association after the restart (no AP in range?)"; fi
    else
        say "supplicant restart failed"; exit 1
    fi
    ;;
off)
    if [ -r "$watchpid" ]; then
        wp=$(sed -n '1p' "$watchpid")
        # only ever signal a live association watcher of ours, never a recycled pid
        case "$(tr '\000' ' ' < "$proc_root/$wp/cmdline" 2>/dev/null)" in
            *assoc-watch*) "$kill_cmd" "$wp" 2>/dev/null || true;;
        esac
        rm -f "$watchpid"
    fi
    if valid_pid; then
        printf 'on\n' > "$state"
        if [ "${PINENOTE_WIFI_NO_KILL:-0}" != 1 ]; then
            "$kill_cmd" "$pid" 2>/dev/null || true
            i=0
            while [ -e "$proc_root/$pid" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
            [ -e "$proc_root/$pid" ] && { say "supplicant did not exit"; exit 1; }
        fi
        rm -f "$pidfile"
    else
        [ ! -e "$pidfile" ] || say "refusing to signal unvalidated pid file"
        rm -f "$pidfile"
        printf 'off\n' > "$state"
    fi
    [ -z "$rfkill_bin" ] || "$rfkill_bin" block wifi || true
    say "off"
    ;;
*) echo "usage: pinenote-wifi-control on|off|status|assoc-watch" >&2; exit 2;;
esac
